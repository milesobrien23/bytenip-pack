{
  "quest.6BCC76ABB232D051.title": "&cRaging",
  "quest.7555550F5F989DF1.title": "Royal Jelly",
  "task.772CF312B194222F.title": "&eLocate&r: Throne Pillar",
  "task.5AFF70B7A019C577.title": "&eCreate&r: A Honey Slime",
  "quest.154A8CF3F52AEA86.title": "&dRoyal Presence",
  "task.7145DE3CF8286F11.title": "&eEnter&r: The Bumblezone",
  "quest.1D04D78186EF9698.quest_desc": [
    "The &dBee Queen&r trades with anyone who brings her the right things.",
    "",
    "Right-click the Queen with an item in hand, or drop it in front of them. JEI lists everything she will take and what she will give back.",
    "",
    "&eNote&r: Now and then the Queen asks for one item in particular. Bring it within 20 minutes for three times the reward.",
  ],
  "quest.2D1E23C3D88A23BF.quest_desc": [
    "&2Bee Stingers&r are one of the Queen's most common gifts.",
    "",
    "Craft a &aStinger Spear&r. You can throw it, and it always poisons anything that isn't undead.",
  ],
  "quest.7E2E6170D2D54D55.title": "Ancient Origins",
  "quest.1D04D78186EF9698.title": "&dThe Queen's Desire",
  "task.6A41A7444FA362EF.title": "&eEnter&r: A Sempiternal Sanctum",
  "quest.66D38EBC946C8EDA.quest_desc": [
    "The White Sanctum's trial is a boss fight. Six &zCosmic Crystals&r smash, spin and fire lasers at you.",
    "",
    "Destroy all six to earn the &aEssence of Continuity&r. Held in your offhand, it saves you from death once by sending you back to your spawn point with full health, then needs &d40&r minutes to recharge.",
  ],
  "quest.7E2E6170D2D54D55.quest_desc": [
    "Six &6Sempiternal Sanctums&r lie far out in the Bumblezone, one for each color of essence.",
    "",
    "Find one and step inside. Loot all over the Bumblezone can hold compasses that point the way, but they only turn up once you've eaten the Essence.",
    "",
    "Deep inside each sanctum is an essence block. Walk into it to start that sanctum's trial.",
  ],
  "quest.31D350A8D0A0BE36.title": "&9Calming",
  "quest.2777FD46A9257D51.quest_desc": [
    "With every task done, right-click the &dBee Queen&r with an empty hand to receive the &aEssence of the Bees&r.",
    "",
    "Eat it. The effect is permanent: Cell Mazes stop angering the bees, the Queen stops giving you Mining Fatigue, and you can take honey from any hive safely.",
    "",
    "&eNote&r: Right-clicking the Queen empty-handed a second time resets the Queen's Desire, so you can earn more Royal Jelly.",
  ],
  "task.72146A8EC953C933.title": "Read",
  "quest.7762E132A4325413.quest_desc": [
    "There's no portal back out. Instead, fall below the bottom of the dimension or fly above its top.",
    "",
    "You won't die. You get Slow Falling and land back where you came from. Beds work in the Bumblezone if you want to set your spawn there.",
  ],
  "quest.624A9385E8A4276C.quest_desc": [
    "A Rootmin under the essence's control waits in the Green Sanctum.",
    "",
    "Defeat it to earn the &aEssence of Life&r. It grows crops and heals your allies and pets.",
  ],
  "quest.529EE766CB2805CD.title": "Bee a Tamer",
  "quest.2D4F9160D403E30C.title": "&6Radiance",
  "task.2904E0146A390369.title": "Any Bee Armor",
  "task.5E4252DC7CD6C45B.title": "&eConsume&r: Essence of the Bees",
  "quest.76A11D2F622E0DDA.title": "Honey Crystal Shield",
  "quest.624A9385E8A4276C.title": "&2Life",
  "quest.715274B9B59C4FBC.quest_desc": [
    "Honey Crystals sit in the Bumblezone's caves and under its water, and they don't grow back.",
    "",
    "Mine them without Silk Touch to collect &aHoney Crystal Shards&r.  ",
  ],
  "quest.7FC377B9E0A1CA04.title": "Is This Still a Compass?",
  "task.6B5245D746745CBB.title": "&eLocate&r: Cell Maze",
  "task.6FF37F24576C3305.title": "&eTame&r: A Beehemoth",
  "quest.76A11D2F622E0DDA.quest_desc": [
    "A &aHoney Crystal Shield&r starts out weak, but it grows stronger every time you repair it with shards in an anvil.",
    "",
    "Fully leveled, it has about double the durability of a normal shield. It can't take Mending.",
  ],
  "quest.6BFA166B8C914A7E.title": "&5Knowing",
  "quest.66D38EBC946C8EDA.title": "&zThe Cosmic Crystal",
  "quest.154A8CF3F52AEA86.quest_desc": [
    "The &dBee Queen&r lives inside the &6Throne Pillar&r.",
    "",
    "Follow the Throne Pillar compass and find the Queen. Until you've eaten the Essence of the Bees, you'll get Mining Fatigue while you're near them.",
  ],
  "quest.577545FE5174565F.title": "Loaded With Bees",
  "quest.1B14C5CAAFC33F58.title": "The Honey Is Alive",
  "quest.31D350A8D0A0BE36.quest_desc": [
    "Drowned and guardians fill the Blue Sanctum, and an Elder Guardian follows them.",
    "",
    "Win the fight to earn the &aEssence of Calming&r. While it's active, mobs stop being angry at you.",
  ],
  "quest.715274B9B59C4FBC.title": "Crystal Clear",
  "quest.1A1B5B9D6D61E111.title": "&dJourney's End",
  "quest.7762E132A4325413.title": "Dive Bombing Exit",
  "quest.577545FE5174565F.quest_desc": [
    "Lava touching still sugar water hardens into &2Sugar Infused Stone&r.",
    "",
    "Use it to build a &aBee Cannon&r. It holds up to 3 bees. Hold the use button and let go to fire, and the bees attack whatever you were looking at.",
  ],
  "quest.2D4F9160D403E30C.quest_desc": [
    "In the Yellow Sanctum you fly through electric rings while vexes attack.",
    "",
    "Finish the course to earn the &aEssence of Radiance&r. In sunlight it buffs you and repairs your armor.",
  ],
  "task.62E4E1AB3C9B5CDF.title": "&eTrade&r: With the Bee Queen",
  "quest.1E53505744F77BFC.quest_desc": [
    "Every bee nest leads somewhere much bigger than it looks.",
    "",
    "Throw an &bEnder Pearl&r at a &aBee Nest&r or &2Beehive&r to get pulled inside &eThe Bumblezone&r, a whole dimension of honeycomb. Any hive works, in any dimension.",
    "",
    "&7&oBring a few bottles. You'll want their honey&r",
  ],
  "quest.529EE766CB2805CD.quest_desc": [
    "Beehemoths are giant bees that love honey.",
    "",
    "Tame one by feeding it &aHoney Buckets&r, then saddle it for a flying mount. It only follows you while you hold a Honey Bucket.",
  ],
  "quest.249DCE3733DC5A61.title": "Sweet Haul",
  "quest.6BCC76ABB232D051.quest_desc": [
    "The Red Sanctum sends wave after wave of mobs at you, ending with a Ravager and a Piglin Brute.",
    "",
    "Clear every wave to earn the &aEssence of Raging&r. Kill the mobs it highlights for stacking Strength.",
  ],
  "quest.7555550F5F989DF1.quest_desc": [
    "Meeting the Queen starts the &bQueen's Desire&r advancements, and every one of them rewards a &aRoyal Jelly Bottle&r.",
    "",
    "Complete one to get a bottle. Drinking it gives Speed, Jump Boost and Slow Falling, or you can trade it back to the Queen for rare rewards.",
  ],
  "quest.7A07C2C4C24EBD41.quest_desc": [
    "Bees here are friendly until you take what's theirs. Then the whole hive turns on you with &cWrath of the Hive&r.",
    "",
    "Feed a &aHoneycomb Brood Block&r or a bee with sugar water or honey until you get &3Protection of the Hive&r. While it lasts, you can take honey without angering anyone.",
  ],
  "quest.1E53505744F77BFC.title": "&6The Buzz",
  "task.6FCA7B3279E17B08.title": "&eGain&r: Protection of the Hive",
  "quest.2D1E23C3D88A23BF.title": "Sting Operation",
  "quest.249DCE3733DC5A61.quest_desc": [
    "&2Filled Porous Honeycomb&r blocks give honey when you use a glass bottle on them.",
    "",
    "Fill four bottles and craft them with a bucket into a &aHoney Bucket&r. Honey Slimes, Beehemoths and the Honey Compass all use one.",
  ],
  "quest.2777FD46A9257D51.title": "&6Essence of the Bees",
  "quest.7A07C2C4C24EBD41.title": "Winning Favors",
  "quest.7FC377B9E0A1CA04.quest_desc": [
    "The Bumblezone is a maze of honeycomb, so you'll want help finding things in it.",
    "",
    "Craft a &aHoney Compass&r. Right-click the air with it in the Bumblezone and it points to a &6Cell Maze&r.",
    "",
    "&o&7Can be found in bumblezone loot or trades with a queen.",
  ],
  "quest.5C9B98FD252466E9.title": "Bee-dazzled",
  "quest.1A1B5B9D6D61E111.quest_desc": [
    "The &bQueen's Desire&r is a list of 16 tasks, tracked in the &eBumblezone&r advancement tab.",
    "",
    "Complete all of them. Some are easy, like drinking honey or breeding Honey Slimes. Two ask a lot more. One wants the &cWither&r killed with a Stinger Spear, the other the &cEnder Dragon&r killed while you wear a full set of bee armor.",
    "",
    "Then return to the &dBee Queen&r.",
  ],
  "quest.6BFA166B8C914A7E.quest_desc": [
    "Spikes rise out of the Purple Sanctum's floor in shifting patterns.",
    "",
    "Survive until the timer runs out to earn the &aEssence of Knowing&r. It highlights nearby mobs and chests and names the structure you're in.",
  ],
  "quest.2777FD46A9257D51.quest_subtitle": "Unlocks the Sempiternal Sanctums",
  "quest.534EE465EEF5CD2A.title": "Lost in the Cells",
  "quest.1B14C5CAAFC33F58.quest_desc": [
    "A small slime soaked in honey becomes a Honey Slime.",
    "",
    "Use a &aHoney Bucket&r on a small or medium slime. Breed Honey Slimes with sugar, and use a glass bottle on an adult to collect honey.",
  ],
  "quest.534EE465EEF5CD2A.quest_desc": [
    "Bees in a Cell Maze turn on intruders, so go in with &3Protection of the Hive&r.",
    "",
    "Find a &6Cell Maze&r and search its &2Honey Cocoons&r. One of them can hold a special Honey Compass that points to a &6Throne Pillar&r.",
  ],
  "task.32652790F033C27A.title": "&eComplete&r: The Queen's Desire",
  "quest.5C9B98FD252466E9.quest_desc": [
    "Bee armor can't be crafted. It comes from the Queen's best trades and from chests across the dimension.",
    "",
    "Get a piece of &aBee Armor&r. Each piece has its own trick, and they all work better the more of the set you wear:",
    "",
    "- &aStingless Bee Helmet&r: Crouch to make bees glow.",
    "",
    "- &aBumble Bee Chestplate&r: Hold jump after jumping to fly for a moment.",
    "",
    "- &aHoney Bee Leggings&r: Collect pollen from flowers.",
    "",
    "- &aCarpenter Bee Boots&r: Run up walls of wood, leaves and honeycomb.",
  ],
}