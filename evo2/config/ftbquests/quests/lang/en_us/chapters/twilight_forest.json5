{
  "task.50DB7F74E8DED1FD.title": "&eDefeat&r: The Knight Phantoms",
  "quest.7511239C30768E14.title": "Dressed for the Cold",
  "quest.44CE672F2B7C2A19.title": "&2Into the Twilight",
  "quest.54634162E905E642.quest_desc": [
    "The &cUr-Ghast&r lives in the &6Dark Tower&r, and you need its Ghast Trap to pull it from the sky.",
    "",
    "Kill three Carminite Ghastlings near a &2Ghast Trap&r in the tower, then give the trap a redstone signal. Defeat it for its &2Fiery Tears&r.",
  ],
  "quest.7595B43C9D13FE10.title": "&cCarminite Acclimation",
  "quest.2193154BFDA39E85.title": "Scepters of Power",
  "quest.5542A37A9EF953A7.title": "Leaves of Steel",
  "quest.2F9558DC3E93A3F1.title": "Maze Runner",
  "task.418FD56A765238FB.title": "&eEat&r: Meef Stroganoff",
  "quest.37FB63B3FB352CAE.title": "More Burning",
  "quest.58BC4E483E511B42.quest_subtitle": "Unlocks the Glacier",
  "task.2773FF8AD4C9290E.title": "&eDefeat&r: Naga",
  "quest.7C09DDA4B4985C80.title": "Magic Trees",
  "quest.7511239C30768E14.quest_desc": [
    "Alpha Yeti Fur crafts into a set of &aYeti Armor&r.",
  ],
  "quest.64D7F591A6A7C679.title": "Locked Biomes",
  "quest.4B85967875654269.title": "Jack and the Beanstalk",
  "quest.5B4D52D663BFF0FB.quest_desc": [
    "The Hydra's blood can be forged into metal.",
    "",
    "Craft a &aFiery Ingot&r from &2Fiery Blood&r (or Fiery Tears) and an iron ingot. The &2Fiery Pickaxe&r smelts the ore it mines.",
  ],
  "task.3F34CBE2FB1E8EC8.title": "&eDefeat&r: Ur-Ghast",
  "quest.37C00876F560067D.quest_desc": [
    "The first boss of the forest lives in the &6Naga Courtyard&r.",
    "",
    "Defeat the &cNaga&r. It drops a pile of &2Naga Scales&r and its trophy, and beating it lets you into the &6Lich Tower&r.",
  ],
  "task.65E35902FA2A330E.title": "Any Lich Scepter",
  "quest.3EFDB9D5A829AC41.title": "Trophied Champion",
  "task.404E20FACBB1DB8E.title": "Any Magic Tree Sapling",
  "quest.7595B43C9D13FE10.quest_subtitle": "Unlocks the Dark Forest Center",
  "quest.69287E8539D17F73.title": "Ultimate Showdown",
  "quest.2193154BFDA39E85.quest_desc": [
    "Each time the Lich dies, it drops one of four scepters, picked at random.",
    "",
    "Collect a &aLich Scepter&r. An empty scepter can be recharged, and JEI shows what each one takes.",
    "",
    "&2Exanimate Essence&r, which the Lich also drops, repairs them.",
  ],
  "quest.7595B43C9D13FE10.quest_desc": [
    "Six &cKnight Phantoms&r haunt the tomb inside the Stronghold.",
    "",
    "Defeat all six. The last one to fall leaves the &aKnight Phantom Trophy&r, and the &6Dark Tower&r in the Dark Forest Center opens up.",
  ],
  "quest.44AAEC3D54357DAC.quest_desc": [
    "With the Naga gone, you can enter the &6Lich Tower&r, where the &cTwilight Lich&r waits.",
    "",
    "Defeat the Lich, which calls up shadow clones of itself during the fight. Beating it unlocks three new biomes and the bosses in them.",
  ],
  "quest.75F444B6B3C19CA0.title": "Mapping the Woods",
  "quest.4CFE6C98D57CF05F.quest_subtitle": "Unlocks the Fire Swamp",
  "task.79302DF3A48BB982.title": "&eDefeat&r: Troll",
  "quest.4B85967875654269.quest_desc": [
    "&aMagic Beans&r grow a beanstalk all the way up to the clouds.",
    "",
    "Find some in the Troll Caves and use them on the glowing &2Uberous Soil&r beneath the clouds, then climb.",
  ],
  "quest.3EFDB9D5A829AC41.quest_desc": [
    "Ruins in the Dark Forest lead into the &6Knight Stronghold&r, sealed behind shield blocks.",
    "",
    "Place any boss trophy on top of the &aTrophy Pedestal&r there. It breaks the shields nearby, but only works if you've beaten the Lich.",
  ],
  "task.7ED2A6E231DB3C99.title": "Feed the Questing Ram",
  "quest.44AAEC3D54357DAC.quest_subtitle": "Unlocks the Dark Forest, Snowy Forest and Swamp",
  "quest.37FB63B3FB352CAE.quest_subtitle": "Unlocks the Thornlands",
  "quest.42BD61163CC48BE1.quest_desc": [
    "The &cSnow Queen&r waits at the top of the &6Aurora Palace&r, out on the Glacier.",
    "",
    "Defeat the Snow Queen. She drops either a &aTri-Bow&r or a &2Seeker Bow&r.",
  ],
  "task.642997AE3A5E2D8E.title": "&eDefeat&r: Minoshroom",
  "quest.75F444B6B3C19CA0.quest_desc": [
    "The &eTwilight Forest&r has its own maps, and the Magic Map only works inside it.",
    "",
    "Craft a &aMagic Map&r to help you find your way around the &eTwilight Forest&r.",
    "",
    "&7Ravens drop the feathers, and Torchberries are picked from Torchberry plants.",
  ],
  "quest.44CE672F2B7C2A19.quest_desc": [
    "A small pool, a ring of flowers and one diamond are all it takes to open a portal to the &eTwilight Forest&r.",
    "",
    "Fill a 2x2 pool of &bWater&r and make sure every block around the edge is grass or dirt with a flower, sapling, fern or other plant on top. Throw a &2Diamond&r into the water and the portal opens with a lightning strike.",
    "",
    "&eNote&r: The portal only forms in the Overworld. ",
    "",
    "&7The portal is only a 2x2 minimum size it can be increased up to 64x64 if you want a larger portal.",
  ],
  "task.2A91384161FE7391.title": "&eVisit&r: Twilight Highlands",
  "quest.4CFE6C98D57CF05F.quest_desc": [
    "The &6Minotaur Labyrinth&r is buried under the Swamp, and the &cMinoshroom&r guards it.",
    "",
    "Defeat the Minoshroom and eat one of the &aMeef Stroganoff&r it drops. Eating it protects you from the heat of the Fire Swamp.",
    "",
    "The Labyrinth has a hidden vault with the &2Mazebreaker&r pickaxe inside.",
  ],
  "quest.58BC4E483E511B42.title": "&cAlpha Fur",
  "quest.388203F2EBE131C6.quest_desc": [
    "The roots under the forest's trees are sometimes &2Liveroot&r and breaking those will give you some liveroots.",
    "",
    "Turn &2Raw Ironwood&r into some &aIronwood Ingot&r for a set of early tools and armor for the &eTwilight Forest&r.",
  ],
  "task.449216524DBED585.title": "&ePlace&r: A trophy on the Trophy Pedestal",
  "quest.41BD984DD2E5B684.quest_desc": [
    "Past the Thornlands lies the last biome of the forest.",
    "",
    "Reach the &6Final Plateau&r. Its castle marks the end of the Twilight Forest's progression for now, and there's no boss waiting inside.",
  ],
  "quest.54634162E905E642.title": "&cTears of Fire",
  "quest.5F720F22C9CE6CE5.quest_desc": [
    "The &6Troll Caves&r run under the Highlands.",
    "",
    "Find a cave and defeat a &cTroll&r. Trolls sometimes drop &2Magic Beans&r, and the caves hide a vault worth breaking into.",
  ],
  "quest.58BC4E483E511B42.quest_desc": [
    "A cave in the Snowy Forest leads to the lair of the &cAlpha Yeti&r.",
    "",
    "Defeat the Alpha Yeti. Its &2Alpha Yeti Fur&r protects you from the Glacier's cold, and it also drops &aIce Bombs&r you can throw.",
  ],
  "quest.5F720F22C9CE6CE5.title": "A Little Trolling",
  "task.3E7EEAE043BB6C34.title": "&eVisit&r: Final Plateau",
  "quest.41BD984DD2E5B684.title": "&6The Final Plateau",
  "task.21936A33FD326E3B.title": "Any Yeti Armor",
  "quest.5B4D52D663BFF0FB.title": "Forged in Fire",
  "task.1407A0120D8FAEBA.title": "&eDefeat&r: Giant Miner",
  "quest.69287E8539D17F73.quest_desc": [
    "With the Hydra, the Ur-Ghast and the Snow Queen all defeated, the &2Acid Rain&r over the &6Highlands&r clears.",
    "",
    "Travel into the Twilight Highlands.",
  ],
  "quest.388203F2EBE131C6.title": "Ironwood",
  "quest.5542A37A9EF953A7.quest_desc": [
    "&aSteeleaf&r can't be crafted or farmed. It only turns up in chests.",
    "",
    "Search the &bHollow Hills&r scattered through the forest for some in the earlier areas of the &eTwilight Forest&r. ",
    "",
    "&o&7The Labyrinth, Knight Stronghold and Dark Tower chests carry it too, once you get that far.",
  ],
  "quest.71D7CA1C4D086798.quest_desc": [
    "Giants live in the clouds at the top of the beanstalk.",
    "",
    "Defeat a &cGiant Miner&r. It drops its &aGiant's Pickaxe&r.",
  ],
  "quest.65161E52E48B9687.title": "Carminite",
  "task.32A2E8C5968818A1.title": "&eDefeat&r: Twilight Lich",
  "quest.69287E8539D17F73.quest_subtitle": "Unlocks the Highlands",
  "task.28BBD36C07488046.title": "&eDefeat&r: Hydra",
  "quest.44AAEC3D54357DAC.title": "&cBring Out Your Dead",
  "task.5996F5990F5A9CB5.title": "&eDefeat&r: Snow Queen",
  "quest.4CFE6C98D57CF05F.title": "&cMighty Stroganoff",
  "quest.42BD61163CC48BE1.title": "&cClear Skies",
  "task.7F069CBEC413F04A.title": "&eDefeat&r: Alpha Yeti",
  "quest.3C9339260475A44A.title": "Scaled Up",
  "quest.37C00876F560067D.quest_subtitle": "Opens the Lich Tower",
  "task.651336B108B9B483.title": "Read",
  "quest.37C00876F560067D.title": "&cThe Naga",
  "quest.65161E52E48B9687.quest_desc": [
    "The Ur-Ghast drops &aCarminite&r, and you can craft more from Borer Essence, redstone and a ghast tear.",
    "",
    "Collect some Carminite. It's the key part of the &2Carminite Reactor&r and the &bCarminite Builder&r.",
  ],
  "quest.3C9339260475A44A.quest_desc": [
    "The Naga's scales make a sturdy set of armor.",
    "",
    "Craft the &aNaga Scale Tunic&r and the &2Naga Scale Leggings&r.",
  ],
  "quest.2F9558DC3E93A3F1.quest_desc": [
    "A &2Maze Map Focus&r wrapped in paper makes a map that shows the tunnels around you.",
    "",
    "A &aBlank Maze Map/Ore Map&r shows ore in the &6Labyrinth&r.",
  ],
  "quest.7C09DDA4B4985C80.quest_desc": [
    "Hollow oak trees hide treasure caches, and those caches can hold one of four magic saplings.",
    "",
    "Find a &aMagic Tree Sapling&r. Each grown tree has a core block, switched on and off with a right-click:",
    "{@pagebreak}",
    "- &2Timewood Clock&r: Speeds up crops and machines within 16 blocks.",
    "",
    "- &aHeart of Transformation&r: Turns the land around it into Enchanted Forest.",
    "",
    "- &2Minewood Core&r: Pulls ore out of the ground nearby.",
    "",
    "- &aSortingwood Engine&r: Moves items from chests within 2 blocks of it into other chests within 16 blocks.",
    "{@pagebreak}",
    "&cWarning&r: Breaking a core only gives back a plain log, so plant the tree where you want it to stay.",
  ],
  "quest.72C5A935B14065AC.quest_desc": [
    "Somewhere in the forest, a &dQuesting Ram&r waits in a small grove of its own.",
    "",
    "Give it one of each of the 16 wool colors. Once it has every color, it rewards you with a &aCrumble Horn&r and a bundle of ore blocks.",
  ],
  "quest.152CAB33D57900F7.title": "Knightmetal",
  "quest.152CAB33D57900F7.quest_desc": [
    "Goblin knights and helmet crabs drop &2Armor Shards&r.",
    "",
    "Craft nine shards into an &2Armor Shard Cluster&r and smelt it for a &aKnightmetal Ingot&r. The &2Knightmetal Sword&r deals extra damage to armored targets.",
  ],
  "quest.72C5A935B14065AC.title": "Consummate Baaahs",
  "quest.66054D6D84B101A6.quest_desc": [
    "The &cHydra&r makes its lair in the Fire Swamp. It will attack with devestating flames and its head will grow back after destroyed.",
    "",
    "Defeat the Hydra. It drops &2Fiery Blood&r for Fiery gear and a stack of Hydra Chops to eat.",
  ],
  "quest.66054D6D84B101A6.title": "&cHydra Slayer",
  "task.4DDF019C0AAA2C0F.title": "&eEnter&r: The Twilight Forest",
  "quest.64D7F591A6A7C679.quest_desc": [
    "The &eTwilight Forest&r is played in order. Walk into a biome you haven't earned yet and a &3Biome Locked&r toast appears, followed by darkness, hunger, fire, frost or acid rain depending on where you are.",
    "",
    "Inside a locked structure you can't break or place blocks, and the mobs there can't be hurt.",
    "",
    "Check the &eTwilight Forest&r advancement tab to see which boss opens the way.",
  ],
  "quest.71D7CA1C4D086798.title": "Cloud Nine",
  "quest.37FB63B3FB352CAE.quest_desc": [
    "The Thornlands are walled in by thorn barriers.",
    "",
    "Use the &2Giant's Pickaxe&r to break &aGiant Obsidian&r inside the Troll Caves.",
    "",
    "Find the &aLamp of Cinders&r in a vault deep in the Troll Caves. It burns the thorns away.",
  ],
}